<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.ultimatekit.panel" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Ultimate Kit" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.ultimatekit.panel.main" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects 2025 (25.0) and newer: 2025, 2026, 2027 ... -->
      <Host Name="AEFT" Version="[25.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.ultimatekit.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <!-- shared memory for the depth model's CPU threads (js/depth.js falls back to one thread without it) -->
            <Parameter>--enable-features=SharedArrayBuffer</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Ultimate Kit</Menu>
          <Geometry>
            <Size>
              <Height>760</Height>
              <Width>340</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>250</Width>
            </MinSize>
            <MaxSize>
              <Height>3000</Height>
              <Width>1600</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
