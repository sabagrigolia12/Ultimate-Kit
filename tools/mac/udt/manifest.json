{
  "manifestVersion": 5,
  "id": "com.ultimatekit.installer",
  "name": "Ultimate Kit Installer",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "installer",
      "label": {
        "default": "Ultimate Kit Installer"
      },
      "minimumSize": { "width": 280, "height": 240 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 340, "height": 420 },
      "preferredFloatingSize": { "width": 380, "height": 440 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
